[
  {
    "id": "grammar_a1_001",
    "level": "A1",
    "title": "ser と estar",
    "explanation": "ser は本質、estar は状態や場所を表します。",
    "examples": [
      {
        "spanish": "Soy estudiante.",
        "japanese": "私は学生です。"
      },
      {
        "spanish": "Estoy en casa.",
        "japanese": "私は家にいます。"
      }
    ],
    "note": "文脈で使い分ける。",
    "commonMistake": "Estoy estudiante. とは通常言いません。"
  },
  {
    "id": "grammar_a1_002",
    "level": "A1",
    "title": "現在形の規則活用",
    "explanation": "-ar/-er/-ir 動詞の現在形を学びます。",
    "examples": [
      {
        "spanish": "Trabajo en una tienda.",
        "japanese": "私は店で働いています。"
      },
      {
        "spanish": "Comen juntos.",
        "japanese": "彼らは一緒に食べます。"
      }
    ],
    "note": "主語に合わせて語尾を変える。",
    "commonMistake": "主語を見ずに原形のまま使うミス。"
  },
  {
    "id": "grammar_a1_003",
    "level": "A1",
    "title": "名詞の性と数",
    "explanation": "名詞・形容詞の性数一致を確認します。",
    "examples": [
      {
        "spanish": "El libro es nuevo.",
        "japanese": "その本は新しいです。"
      },
      {
        "spanish": "Las mesas son grandes.",
        "japanese": "その机は大きいです。"
      }
    ],
    "note": "冠詞も一致させる。",
    "commonMistake": "las libro のような不一致。"
  }
]